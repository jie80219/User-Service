#--------------------------------------------------------------------
# User Service — copy this file to `.env` and fill in actual secrets.
# `.env` is gitignored (see repo root .gitignore).
#
# Generate JWT_SECRET with:  openssl rand -base64 32
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

JWT_SECRET =

database.default.hostname = user_DB
database.default.database = user
database.default.username = root
database.default.password =
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port     = 5432

SPIFFE_ID      = spiffe://zt.local/user-service
SPIFFE_SHM_DIR = /certs
LSVID_REQUIRED = 0
